# Caddy: the one reverse proxy on the VM. It owns ports 80/443, gets and
# renews certificates automatically, and routes each hostname to one service
# on the shared "edge" Docker network.
#
# Before starting: point each hostname's DNS A/AAAA record at the VM, open 80
# and 443 in the VPC firewall, and set ACME_EMAIL in deploy/shared-vm/.env.

{
	email {$ACME_EMAIL}
}

# ── HOP Chat ─────────────────────────────────────────────────────────────────
# Must be its own (sub)domain, not a path: the app serves /api, /c/, /a/,
# /embed/, /widget/ and the admin UI from the root. Set PUBLIC_BASE_URL in the
# app's .env to exactly this origin, e.g. https://chat.example.com.
{$HOP_CHAT_HOST:chat.example.com} {
	# "hop-chat" is the alias the app's frontend gets on the edge network
	# (docker-compose.override.yml). Caddy streams the chat's server-sent
	# events as they arrive and has no response timeout, so long answers are
	# not cut off. Deliberately no `encode` here: the app's responses are small
	# and compressing would only risk buffering the streams.
	reverse_proxy hop-chat:80

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ── Your other two services ──────────────────────────────────────────────────
# Put each on the edge network with an alias (see README.md), then:
#
# {$SERVICE_TWO_HOST:two.example.com} {
# 	reverse_proxy service-two:8000
# }
#
# {$SERVICE_THREE_HOST:three.example.com} {
# 	reverse_proxy service-three:3000
# }
