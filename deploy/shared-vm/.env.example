# Copy to deploy/shared-vm/.env — read by docker-compose.proxy.yml (Caddy only).
# Let's Encrypt account email: expiry and problem notices go here.
ACME_EMAIL=ops@example.com

# Hostnames Caddy serves; each needs a DNS record pointing at this VM.
HOP_CHAT_HOST=chat.example.com
