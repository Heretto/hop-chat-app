# Copy to .env (repo root, read by docker compose) and/or backend/.env (read by a
# local uvicorn). Generate each secret with: openssl rand -hex 32
#
# ENCRYPTION_KEY encrypts every stored credential (AI keys, Deploy tokens). It
# cannot be rotated: lose or change it and those credentials are unreadable.
APP_SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Local runs only (compose sets its own SQLite path on a volume).
DATABASE_URL=sqlite:///./hop-chat.db

# The origin visitors' browsers reach the chat on. Embed snippets and chat URLs
# are built from it. Locally that is the Angular dev server.
PUBLIC_BASE_URL=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# Per-IP limit on visitor messages (each one is a paid model call).
PUBLIC_MESSAGE_RATE_LIMIT=20/minute
