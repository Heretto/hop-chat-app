# Copy to .env (repo root, read by docker compose) and/or backend/.env (read by a
# local uvicorn). Generate each secret with: openssl rand -hex 32
#
# ENCRYPTION_KEY encrypts every stored credential (AI keys, Deploy tokens). It
# cannot be rotated: lose or change it and those credentials are unreadable.
APP_SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Local runs only (compose sets its own SQLite path on a volume).
DATABASE_URL=sqlite:///./hop-chat.db

# The origin visitors' browsers reach the chat on. Embed snippets and chat URLs
# are built from it. Locally that is the Angular dev server.
PUBLIC_BASE_URL=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# ── Sign-up and sign-in (hop-core) ───────────────────────────────────────────
# hop-core handles accounts; these are its settings, passed through by
# docker-compose.yml (and read directly from backend/.env when running locally).
#
# SSO_ONLY=true is the recommended production setup: only Google/Microsoft
# sign-in, no password sign-up, login or reset. Configure at least one provider
# first — with none, nobody can sign in. Existing password users keep their
# account by signing in with SSO under the same email.
# SSO_ONLY=false
#
# Google: an OAuth client ID, with PUBLIC_BASE_URL under
# "Authorized JavaScript origins".
# GOOGLE_OAUTH_CLIENT_ID=
#
# Microsoft: an app registration with redirect URI
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/sso/microsoft/callback
# Set your own tenant ID: the default, "common", accepts any Microsoft account
# (see hop-core AGENTS.md, "SSO-only deployments").
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=
#
# Where providers send people back. Docker defaults it to PUBLIC_BASE_URL.
# OAUTH_REDIRECT_BASE_URL=
#
# Limit who can sign up, by email domain (comma-separated). Applies to SSO
# sign-ups and invitees.
# ALLOWED_EMAIL_DOMAINS=example.com
#
# Put every new account into one organization (by its slug) instead of giving
# each its own. Only with sign-up restricted (SSO_ONLY plus
# ALLOWED_EMAIL_DOMAINS): everyone who signs up joins that organization. On a
# fresh database the first sign-up creates it and becomes its admin, so sign in
# yourself first. SINGLE_ORG_NAME is used only when the organization is
# created; it defaults to the slug in title case.
# SINGLE_ORG_MODE=false
# SINGLE_ORG_SLUG=
# SINGLE_ORG_NAME=

# Per-IP limit on visitor messages (each one is a paid model call).
PUBLIC_MESSAGE_RATE_LIMIT=20/minute
